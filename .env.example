# ---------------------------------------------------------------------------
# Coldwire — environment configuration
# Copy this file to `.env` and adjust the values for your installation.
# ---------------------------------------------------------------------------

APP_NAME="Coldwire"
APP_ENV=production           # production | development
APP_DEBUG=false              # true prints stack traces on the 500 page
APP_URL=http://localhost:8080
APP_KEY=                     # 64 hex chars; generate with: php bin/console key:generate
APP_TIMEZONE=UTC

# How links are built.
#   path      /forum/general             — needs mod_rewrite or nginx try_files
#   pathinfo  /index.php/forum/general   — no rewriting needed, still readable
#   query     /index.php?r=/forum/general — works on anything that runs PHP
APP_URL_MODE=query
APP_ENTRYPOINT=/index.php

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=coldwire
DB_USERNAME=coldwire
DB_PASSWORD=secret
DB_CHARSET=utf8mb4

SESSION_NAME=coldwire_session
SESSION_LIFETIME=7200        # seconds
SESSION_SECURE=false         # set to true when serving over HTTPS
SESSION_SAMESITE=Lax

MAIL_TRANSPORT=log           # log | mail
MAIL_FROM=no-reply@localhost
MAIL_FROM_NAME="Coldwire"

UPLOAD_MAX_AVATAR_BYTES=4194304
